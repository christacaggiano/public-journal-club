# Required: your Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: models. The critique model writes the highlights, ratings and TL;DR.
# The research model does the literature search, summary, context, glossary and quote repair.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_RESEARCH_MODEL=claude-sonnet-5-5

# Optional: web search. The total is split between the background check and the context search.
# ENABLE_WEB_SEARCH=true
# WEB_SEARCH_MAX_USES=4

# Optional: Opus fast mode for the critique. Much faster writing at twice the per-token price.
# CRITIQUE_FAST_MODE=false

# Storage. On Vercel, connect a Blob store and BLOB_READ_WRITE_TOKEN is added for you.
# Without it (local development), files are kept in ./.data
# BLOB_READ_WRITE_TOKEN=
# Use "public" only if your Blob store was created with public access (default private)
# BLOB_ACCESS=private

# Optional: rate limiting with Upstash Redis (Vercel Marketplace adds KV_REST_API_URL / KV_REST_API_TOKEN)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Limits
# REVIEWS_PER_DAY=5
# MAX_PDF_MB=20
# MAX_PAGES=60

# Optional: your email for Crossref's "polite" API pool (used for retraction checks)
# CROSSREF_MAILTO=
